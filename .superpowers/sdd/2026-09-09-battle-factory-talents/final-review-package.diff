+
+  var CLES = Object.keys(NATURES);
+
+  function table() {
+    return NATURES;
+  }
+
+  function cles() {
+    return CLES.slice();
+  }
+
+  function liste() {
+    return CLES.slice();
+  }
+
+  function nom(cle, lang) {
+    var n = NATURES[cle];
+    if (!n) return cle || "";
+    var l = lang || "fr";
+    return (n.nom && (n.nom[l] || n.nom.fr)) || cle;
+  }
+
+  function de(p) {
+    return (p && p.nature) ? p.nature : null;
+  }
+
+  function tirer(h) {
+    if (!h) return null;
+    var l = liste();
+    if (typeof h.choisir === "function") return h.choisir(l);
