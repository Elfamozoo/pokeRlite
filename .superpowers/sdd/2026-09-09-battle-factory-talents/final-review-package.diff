+
+  // Higher score should overwrite
+  P.enregistrerRecordUsine(21);
+  assert.strictEqual(P.usineLire().record, 21);
+});
+
+test("debloquerSymboleUsine(type) unlocks argent and or symbols", () => {
+  initProgContext();
